#. module: muk_mcp_oauth
#: model_terms:ir.ui.view,arch_db:muk_mcp_oauth.view_res_config_settings_form
msgid ""
"Every MCP access is read only, whatever its key: tools that change data are "
"refused. Keys keep their own scope for when this is turned off."
msgstr "Tout accès MCP est en lecture seule, quelle que soit sa clé : les outils qui modifient des données sont refusés. Les clés gardent leur propre portée pour quand ce réglage sera désactivé."

