<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Logos: static/src/img/brands/SOURCES.md -->
    <!-- MuK's Connect wizard, reorganised: sign-in (OAuth) first, bearer-key setups in a second tab -->
    <record id="view_connect_form" model="ir.ui.view">
        <field name="name">muk_mcp.connect.form.oauth</field>
        <field name="model">muk_mcp.connect</field>
        <field name="inherit_id" ref="muk_mcp.view_connect_form"/>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="class">o_mcp_connect</attribute>
                <attribute name="create">0</attribute>
            </form>
            <notebook position="attributes">
                <attribute name="name">key_clients</attribute>
                <attribute name="class">o_mcp_key_clients</attribute>
            </notebook>
            <!-- shown above all tabs instead -->
            <xpath expr="//sheet/group/field[@name='mcp_url']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- superseded by the Claude app's connectors -->
            <page name="claude_desktop" position="replace"/>

            <xpath expr="//div[hasclass('oe_title')]/p" position="replace">
                <p class="text-muted">
                    Your AI tool opens Odoo in your browser: you sign in, approve, and it then works with your own
                    Odoo access rights. No key to copy.
                </p>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="alert alert-info d-flex align-items-center gap-3 o_mcp_url" role="alert">
                    <i class="fa fa-link fa-lg" title="MCP URL"/>
                    <div class="flex-grow-1">
                        <div class="small fw-bold">MCP URL</div>
                        <field name="mcp_url" widget="CopyClipboardChar" readonly="1" nolabel="1"/>
                    </div>
                </div>
                <notebook name="connect_modes">
                    <page string="Sign in (recommended)" name="sign_in">
                        <div class="row g-3">
                            <div class="col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header d-flex align-items-center gap-2">
                                        <img src="/muk_mcp_oauth/static/src/img/brands/claude.svg" alt="" class="o_mcp_logo"/>
                                        <strong>Claude</strong>
                                        <span class="text-muted small">desktop app, claude.ai</span>
                                        <a href="https://support.claude.com/en/articles/11175166-get-started-with-custom-connectors-using-remote-mcp" target="_blank" rel="noopener noreferrer" class="ms-auto small text-nowrap">Official guide <i class="fa fa-external-link" title="External link"/></a>
                                    </div>
                                    <div class="card-body">
                                        <ol class="o_mcp_steps">
                                            <li><b>Customize &gt; Connectors</b>, <b>+ Add &gt; Add custom connector</b></li>
                                            <li>Name: <code>Odoo</code>, URL: the <b>MCP URL</b> above, then <b>Continue</b> twice</li>
                                            <li>Authentication: <b>Sign in now</b>, then <b>Add</b>: sign in to Odoo and <b>Allow</b></li>
                                            <li>In a conversation: <code>+</code> &gt; <b>Connectors</b> &gt; Odoo</li>
                                        </ol>
                                        <p class="text-muted small mb-0">Team and Enterprise plans: an owner first adds it in <b>Organization settings &gt; Connectors</b>; members then click <b>Connect</b> in <b>Customize &gt; Connectors</b>.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header d-flex align-items-center gap-2">
                                        <img src="/muk_mcp_oauth/static/src/img/brands/openai.svg" alt="" class="o_mcp_logo"/>
                                        <strong>ChatGPT</strong>
                                        <span class="text-muted small">web, desktop app</span>
                                        <a href="https://help.openai.com/en/articles/12584461-connecting-custom-mcp-servers-in-chatgpt" target="_blank" rel="noopener noreferrer" class="ms-auto small text-nowrap">Official guide <i class="fa fa-external-link" title="External link"/></a>
                                    </div>
                                    <div class="card-body">
                                        <ol class="o_mcp_steps">
                                            <li><b>Plugins</b>, <code>+</code> &gt; <b>Add custom MCP server</b></li>
                                            <li>Name: <code>Odoo</code>, Connection: the <b>MCP URL</b> above, authentication: <code>OAuth</code></li>
                                            <li>Tick <b>I understand and want to continue</b>, then <b>Create as a plugin</b>: sign in to Odoo and <b>Allow</b></li>
                                            <li>In a conversation: type <code>@</code> and pick Odoo</li>
                                        </ol>
                                        <p class="text-muted small mb-0">ChatGPT Business, Enterprise and Edu, on the web: workspace admins add and publish it.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header d-flex align-items-center gap-2">
                                        <img src="/muk_mcp_oauth/static/src/img/brands/claude-code.svg" alt="" class="o_mcp_logo"/>
                                        <strong>Claude Code</strong>
                                        <a href="https://code.claude.com/docs/en/mcp" target="_blank" rel="noopener noreferrer" class="ms-auto small text-nowrap">Official guide <i class="fa fa-external-link" title="External link"/></a>
                                    </div>
                                    <div class="card-body o_mcp_snippet">
                                        <div class="o_mcp_code">
                                            <field name="claude_code_oauth_cmd" readonly="1" nolabel="1"/>
                                            <field name="claude_code_oauth_cmd" widget="CopyClipboardButton" string="Copy" class="o_mcp_copy" nolabel="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header d-flex align-items-center gap-2">
                                        <img src="/muk_mcp_oauth/static/src/img/brands/codex.svg" alt="" class="o_mcp_logo"/>
                                        <strong>Codex</strong>
                                        <a href="https://developers.openai.com/codex/mcp" target="_blank" rel="noopener noreferrer" class="ms-auto small text-nowrap">Official guide <i class="fa fa-external-link" title="External link"/></a>
                                    </div>
                                    <div class="card-body o_mcp_snippet">
                                        <div class="o_mcp_code">
                                            <field name="codex_oauth_cmd" readonly="1" nolabel="1"/>
                                            <field name="codex_oauth_cmd" widget="CopyClipboardButton" string="Copy" class="o_mcp_copy" nolabel="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </page>
                    <page string="With a key" name="with_key">
                        <p class="text-muted">For tools that cannot sign in. The key gives access with your rights until you revoke it.</p>
                    </page>
                </notebook>
            </xpath>

            <!-- MuK's key generation and per-client snippets go to the second tab -->
            <xpath expr="//page[@name='with_key']" position="inside">
                <xpath expr="//sheet/group" position="move"/>
                <xpath expr="//button[@name='action_generate_key']" position="move"/>
                <xpath expr="//notebook[@name='key_clients']" position="move"/>
            </xpath>
        </field>
    </record>

    <!-- Same wizard as a full page, with a link of its own: /odoo/connect-ai/new -->
    <record id="action_connect_page" model="ir.actions.act_window">
        <field name="name">Connect AI</field>
        <field name="res_model">muk_mcp.connect</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="muk_mcp.view_connect_form"/>
        <field name="target">main</field><!-- clears the breadcrumbs: the URL stays /odoo/connect-ai/new -->
        <field name="path">connect-ai</field>
    </record>

    <!-- Reachable by every user, from their preferences (the MCP menu is for administrators) -->
    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.form.mcp</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//h1" position="after">
                <a href="/odoo/connect-ai/new" class="btn btn-secondary mb-3">
                    <i class="fa fa-plug" title="Connect an AI tool"/> Connect an AI tool
                </a>
            </xpath>
        </field>
    </record>

</odoo>
